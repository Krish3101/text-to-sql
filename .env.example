# ==============================================================================
# Text-to-SQL Generator Environment Configuration
# ==============================================================================

# OpenRouter Cloud LLM Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Recommended Models:
# - meta-llama/llama-3.1-70b-instruct (High accuracy, recommended)
# - meta-llama/llama-3.3-70b-instruct (Latest Llama 3.3)
# - qwen/qwen-2.5-coder-32b-instruct (Specialized coding model)
# - meta-llama/llama-3.1-8b-instruct:free (Free tier option)
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# Local SQLite Database Path
DB_PATH=ecommerce.db
